			<field>ЧасыФактическийПериодДействия</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Зарплата.Сотрудник КАК Сотрудник,
	Зарплата.Ставка КАК Ставка,
	Зарплата.СуммаРасчета КАК СуммаРасчета,
	Зарплата.ПериодДействия КАК ПериодДействия,
	Зарплата.ПериодДействияНачало КАК ПериодДействияНачало,
	Зарплата.ПериодДействияКонец КАК ПериодДействияКонец,
	ЗарплатаДанныеГрафика.ЧасыФактическийПериодДействия КАК ЧасыФактическийПериодДействия
ИЗ
	РегистрРасчета.Зарплата КАК Зарплата,
	РегистрРасчета.Зарплата.ДанныеГрафика КАК ЗарплатаДанныеГрафика
ГДЕ
	Зарплата.ВидРасчета = &amp;ВидРасчета
	И ЗарплатаДанныеГрафика.ВидРасчета = &amp;ВидРасчета
{ГДЕ
	(Зарплата.ПериодДействия МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания)}</query>
	</dataSet>
