
Процедура ПередЗаписью(Отказ)
	
	ФИО = Новый Массив;
	ФИО.Добавить(СокрЛП(Фамилия)); 
	ФИО.Добавить(Лев(СокрЛП(Имя), 1));
	ФИО.Добавить(Лев(СокрЛП(Отчество), 1));
	
	Если ФИО[2] <> "" Тогда
	
		ЭтотОбъект.Наименование = СтрШаблон("%1 %2.%3.", ФИО[0], ФИО[1], ФИО[2]);	
	
	Иначе
	
		ЭтотОбъект.Наименование = СтрШаблон("%1 %2.", ФИО[0], ФИО[1]);
	          
	КонецЕсли;
	
КонецПроцедуры
